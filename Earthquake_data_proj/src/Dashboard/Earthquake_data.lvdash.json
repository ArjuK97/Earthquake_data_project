{
  "datasets": [
    {
      "name": "eb80f434",
      "displayName": "Earthquake_Detail",
      "queryLines": [
        "select * from geo_proj.silver.earthquake_data_final;"
      ],
      "catalog": "geo_proj",
      "schema": "silver"
    },
    {
      "name": "6578a1b2",
      "displayName": "Earthquake_Type",
      "queryLines": [
        "\r\n",
        "\r\n",
        "\r\n",
        "SELECT \r\n",
        "    COUNT(*) AS total_magnitude_bucket,\r\n",
        "    magnitude_bucket\r\n",
        "FROM (\r\n",
        "    SELECT \r\n",
        "        CASE\r\n",
        "            WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "            WHEN mag >= 2 AND mag < 3 THEN 'Minor [2-3)'\r\n",
        "            WHEN mag >= 3 AND mag < 4 THEN 'Light [3-4)'\r\n",
        "            ELSE 'Moderate+ (4+)'\r\n",
        "        END AS magnitude_bucket\r\n",
        "    FROM earthquake_data_final\r\n",
        ")\r\n",
        "GROUP BY magnitude_bucket"
      ],
      "catalog": "geo_proj",
      "schema": "silver"
    },
    {
      "name": "c4f4ac85",
      "displayName": "Earthquake_Country_Wise",
      "queryLines": [
        "SELECT\r\n",
        " count(*) AS event_count,\r\n",
        "  CASE\r\n",
        "    WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        "    ELSE split(place, ', ')[1]\r\n",
        "  END AS country\r\n",
        "FROM (\r\n",
        "  SELECT\r\n",
        "    time,\r\n",
        "    title,\r\n",
        "    mag,\r\n",
        "    longitude,\r\n",
        "    place,\r\n",
        "    latitude\r\n",
        "  FROM silver.earthquake_data_final\r\n",
        ")\r\n",
        "GROUP BY country"
      ],
      "catalog": "geo_proj",
      "schema": "default"
    }
  ],
